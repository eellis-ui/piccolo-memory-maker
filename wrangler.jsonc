// Deploy config for the frontend host: the Cloudflare Worker named
// "piccoload" (static assets, no server code) serves piccoload.com.
// Deploy manually with:
//   npm run build && npx wrangler deploy
// (needs CLOUDFLARE_API_TOKEN + CLOUDFLARE_ACCOUNT_ID in the environment,
// or `npx wrangler login`). CI does the same on pushes to main once the
// repo secrets are set — see .github/workflows/ci.yml.
{
  "name": "piccoload",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
